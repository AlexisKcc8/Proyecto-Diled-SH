---
import { Icon } from "astro-icon/components";
import ContainerCenter from "./ContainerCenter.astro";
---

<footer
  class="relative text-white flex justify-center items-center px-6 laptop:px-0 overflow-hidden"
>
  <div class="absolute top-0 left-0 z-10 h-full w-full">
    <div
      class="absolute bottom-auto right-auto left-0 top-0 h-[300px] w-[300px] laptop:h-[500px] laptop:w-[500px] -translate-x-[30%] translate-y-[20%] rounded-full bg-[rgba(173,109,244,0.5)] opacity-50 blur-[80px]"
    >
    </div>
  </div>
  <ContainerCenter
    class="flex flex-col-reverse laptop:flex-row justify-between py-6"
  >
    <aside class="flex flex-col gap-8 text-center laptop:text-left">
      <div class="border-b border-white py-2">
        <p class="text-2xl font-bold mb-6">
          Diled - Smart <span class="text-diled-600">Home</span>
        </p>
        <ul class="flex gap-4 flex-col items-center laptop:flex-row">
          <li class="flex gap-2 items-center">
            <a
              href="https://www.facebook.com/profile.php?id=100025791056439"
              target="_blank"
              ><Icon
                name="facebook"
                class="text-white w-7 h-7 laptop:w-9 laptop:h-9"
              /></a
            >
            DiLed Smart Home Solutions
          </li>
          <li class="flex gap-2 items-center">
            <a
              href="https://www.instagram.com/diled_smart_home/"
              target="_blank"
              ><Icon
                name="instagram"
                class="text-white w-7 h-7 laptop:w-9 laptop:h-9"
              /></a
            >
            diLed_smart_home
          </li>
        </ul>
      </div>
      <div>
        <p>
          Soluciones IT | Smart Homes | Seguridad | Automatización Residencial |
          Conectividad.
        </p>
        <p>&copy; {new Date().getFullYear()}. Todos los derechos reservados.</p>
      </div>
    </aside>
    <aside>
      <section class="flex justify-center laptop:justify-end">
        <ul class="hidden laptop:flex gap-4 flex-col laptop:flex-row">
          <li class="flex gap-2 items-center z-40">
            <a
              href="https://www.facebook.com/profile.php?id=100025791056439"
              target="_blank"
              class="flex gap-4 items-center"
              ><Icon
                name="facebook"
                class="text-white w-7 h-7 laptop:w-9 laptop:h-9"
              />
              DiLed Smart Home Solutions
            </a>
          </li>
          <li class="flex gap-2 items-center z-40">
            <a
              href="https://www.instagram.com/diled_smart_home/"
              target="_blank"
              class="flex gap-4 items-center"
              ><Icon
                name="instagram"
                class="text-white w-7 h-7 laptop:w-9 laptop:h-9"
              />diLed_smart_home</a
            >
          </li>
        </ul>
      </section>

      <section
        class="flex flex-col laptop:items-end laptop:justify-end mt-3 text-center"
      >
        <p class="my-3 text-diled-600 text-xl font-semibold">
          ¡Ven a visitarnos! Estamos en:
        </p>
        <a
          href="https://maps.app.goo.gl/wEu1Vwyz4KnYSPdi6"
          target="_blank"
          class="flex gap-4 items-center laptop:w-[60%] z-40"
          ><Icon name="maps" class="text-white w-7 h-7 laptop:w-9 laptop:h-9" />
          <span class="laptop:text-end">
            Calle 1H #176 x 14 y 16, Col. México Norte, Mérida, Yucatan 97128.
            listos para ayudarte.</span
          >
        </a>
      </section>
      <!-- //iconos -->
    </aside>
  </ContainerCenter>
</footer>
