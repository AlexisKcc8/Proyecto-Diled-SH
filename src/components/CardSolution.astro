---
const { data = [] } = Astro.props;
---

<article class=" max-w-sm mx-auto overflow-hidden bg-[#FAFAFA] snap-center rounded-2xl shadow-lg  card-product ease-in duration-300 w-[22rem] text-center p-0 flex flex-col  flex-shrink-0 border border-gray-300 py-6 hover:cursor-pointer laptop:w-[20rem]" 

data-aos="fade"
data-aos-offset="200"
data-aos-delay="50"
data-aos-duration="700"
data-aos-easing="ease-in"
      
>
  <header class="px-2 py-4 h-[5rem] flex items-center justify-center">
    <h2 class="font-semibold text-xl tracking-tight overflow-hidden text-ellipsis whitespace-pre-line line-clamp-3">
      {data.title}
    </h2>
  </header>
  <section class="px-2 flex-1">
    <div class="w-full aspect-[5/6] relative overflow-hidden bg-gray-100">
      <img
        src={data.image}
        alt={`Image-${data.title}`}
        class="w-full h-full object-cover"
                
      />
    </div>
    <footer class="my-4">
      <p class="">
          {data.description}
      </p>
    </footer>
  </section>
</article>