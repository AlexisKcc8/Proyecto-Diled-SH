---
  const { title, bgImage } = Astro.props;
---

<article class="w-[22rem] max-w-sm mx-auto overflow-hidden snap-center rounded-2xl shadow-lg   relative ease-in duration-300  text-center p-0 flex flex-col  flex-shrink-0 border border-gray-300  hover:cursor-pointer hover:scale-[1.03] hover:ease-in laptop:w-[20rem]" >
  <img src={bgImage} alt="" class="w-full h-full object-cover" />
  <header class="absolute top-0 left-0 w-full  bg-white/50  px-2 py-4 flex  justify-center">
    <h2 class="font-bold text-3xl  tracking-tight overflow-hidden text-ellipsis whitespace-pre-line line-clamp-3">
      {title}
    </h2>
  </header>
</article>