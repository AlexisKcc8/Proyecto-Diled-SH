      {OFFICESCORPORATE.map((solution) => (
        <CardSolution data={solution} />
      ))}
    </Carousel>
    
    <Carousel carouselId="solutions-RESIDENTIAL">
      <CoverCardSolution title="RESIDENCIAL" bgImage={bgRESIDENTIAL} />
      {RESIDENTIAL.map((solution) => (
        <CardSolution data={solution} />
      ))}
    </Carousel>
    
  </ContainerCenter>
</section>


