---
<section class="flex justify-center items-center scroll-mt-20" id="Successful-Solutions">
  <ContainerCenter class="overflow-hidden flex flex-col items-center justify-center">
    <h2 class="text-3xl mt-8 mb-8 font-semibold text-center max-w-[80%] 
    laptop:text-5xl laptop:text-start laptop:w-[100%] laptop:max-w-[100%] ">De la Idea al Logro: <span class="text-diled-600">Soluciones</span><div class="border hidden laptop:block laptop:w-0 laptop:h-0"><br></div>  que Transforman</h2>

    <Carousel carouselId="solutions-TOWNHOUSES">
      <CoverCardSolution title="TOWNHOUSES" bgImage={bgTOWNHOUSES} />
      {TOWNHOUSES.map((solution) => (
        <CardSolution data={solution} />
      ))}
    </Carousel>
    
    <Carousel carouselId="solutions-SCHOOLS">
      <CoverCardSolution title="ESCUELAS Y COLEGIOS" bgImage={bgSCHOOLS} />
      {SCHOOLS.map((solution) => (
        <CardSolution data={solution} />
      ))}
    </Carousel>

    <Carousel carouselId="solutions-AIRBNB">
      <CoverCardSolution title="AIRBNB" bgImage={bgAIRBNB} />
      {AIRBNB.map((solution) => (
        <CardSolution data={solution} />
      ))}
    </Carousel>

    <Carousel carouselId="solutions-SMALLBUSINESSES">
