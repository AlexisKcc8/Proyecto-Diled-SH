---
import ContainerCenter from "@components/ContainerCenter.astro";
import { Icon } from "astro-icon/components";
import Brands from "./Brands.astro";
import { Image } from "astro:assets";
import enchufes from "@assets/enchufes.svg";
import camaraEntrada from "@assets/camara-entrada.svg";
import enchufesConCelular from "@assets/enchufes-con-celular.svg";
import bocina from "@assets/bocina.svg";
import cuby from "@assets/cuby.svg";
import hikVision from "@assets/hik-vision.svg";
import bto from "@assets/bto.svg";
import { twMerge } from "tailwind-merge";

// class="bg-[url(/src/assets/1.svg)] bg-no-repeat bg-center bg-cover text-white h-screen pt-6 laptop:pt-0 flex items-center justify-center"

// bg-gradient-to-b from-black/0 to-black/80 w-full h-screen justify-center items-center flex
let imagesBackground = [
  // imagenes a la izquierda
  {
    url: enchufesConCelular,
    classContainerImage: "top-0 left-0 laptop:top-6 laptop:left-28 rotate-12"
  },
  
  {
    url: bto,
    classContainerImage: "top-46 -left-12  laptop:block laptop:top-46 laptop:left-14 -rotate-12"
  },
  {
    url: cuby,
    classContainerImage: "-bottom-10 left-0 laptop:top-86 laptop:left-28 -rotate-12"
  },
  // imagenes a la derecha
  {
    url: camaraEntrada,
    classContainerImage: "top-0 -right-5 laptop:top-6 laptop:right-28 -rotate-12 "
  },
  {
    url: hikVision,
    classContainerImage: "top-46 -right-12  laptop:block laptop:top-46 laptop:right-8 rotate-12"
  },
  {
    url: bocina,
    classContainerImage: "-bottom-10 right-0 laptop:top-86 laptop:right-28 rotate-12"
  }, 
]
---
<section class="relative h-screen w-full bg-slate-950 text-white flex justify-center items-center overflow-hidden mt-[4rem]">
  
      {
        imagesBackground.map((imageBackground) => (
           <div  class={twMerge("absolute w-3/12 h-3/12 laptop:w-66 laptop:h-48", imageBackground.classContainerImage)} data-aos="fade" data-aos-delay="500">
         
              <Image
                src={imageBackground.url}
                class="relative w-full h-full object-cover rounded-lg z-0 opacity-30 "
                alt={`Image-${imageBackground.url}`}
                
              />
          </div>
        ))
      }
     

      <ContainerCenter
        class="flex flex-col justify-center items-center gap-6 laptop:gap-10 px-6 laptop:px-0"
      >
        <div
          class="flex flex-col laptop:flex-row items-center justify-center gap-6 laptop:gap-10"
        >
          <section class="flex flex-col gap-6 laptop:gap-10 items-center">

            <h1
              class="text-4xl laptop:text-6xl prose font-semibold animate-fade-up text-center laptop:max-w-[70%] max-w-[85%]"
            >
              Automatización, Seguridad e Iluminación <span
                class="text-diled-600">Inteligente</span
              > para tu Hogar
            </h1>
            <p
              class="text-[.8rem] laptop:text-lg animate-fade-up prose animate-delay-300 text-center max-w-[85%] laptop:max-w-[60%]"
            >
              En Diled, transformamos tu hogar con tecnología avanzada en
              automatización residencial, iluminación, seguridad, audio, cine en
              casa, conectividad y control de acceso. Disfruta de un hogar más
              seguro, eficiente y cómodo con soluciones diseñadas para ti.
            </p>

            <button
              class="bg-diled-600 laptop:w-1/4 rounded-xl flex gap-1 justify-center items-center laptop:gap-5 text-white animate-fade-up animate-delay-500 py-4 px-2 laptop:text-lg"
              ><span class="font-semibold">Transforma tu hogar hoy</span>
              <Icon name="whatsapp" class="h-8 w-8" /></button
            >
          </section>
        </div>
      </ContainerCenter>
</section>

