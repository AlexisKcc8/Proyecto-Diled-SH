---
import ContainerCenter from "@components/ContainerCenter.astro";
import { Icon } from "astro-icon/components";
import Brands from "./Brands.astro";
import { Image } from "astro:assets";
import enchufes from "@assets/enchufes.svg";
import camaraEntrada from "@assets/camara-entrada.svg";
import enchufesConCelular from "@assets/enchufes-con-celular.svg";
import bocina from "@assets/bocina.svg";
import cuby from "@assets/cuby.svg";
import hikVision from "@assets/hik-vision.svg";
import bto from "@assets/bto.svg";
import { twMerge } from "tailwind-merge";
let imagesBackground = [
  // imagenes a la izquierda
  {
    url: enchufesConCelular,
    classContainerImage: " rotate-12",
  },

  {
    url: cuby,
    classContainerImage: " -rotate-12",
  },
  // imagenes a la derecha
  {
    url: camaraEntrada,
    classContainerImage: " -rotate-12 ",
  },

  {
    url: bocina,
    classContainerImage: " rotate-12",
  },
];
---

<section
  class="relative h-screen w-full bg-[#f5f5f7] text-black flex justify-center items-center overflow-hidden mt-[4rem] pb-16"
  id="hero"
>
  <div class="absolute top-0 z-1 h-full w-full">
    <div
      class="absolute left-[50%] top-[50%] h-[80%] w-[90%] -translate-x-[50%] -translate-y-[50%] rounded-full bg-[rgba(173,109,244,0.5)] opacity-60 blur-[70px] z-0"
    >
    </div>
  </div>
  <div class="absolute w-full h-screen flex laptop:px-32">
    {/* Columna izquierda */}
    <div class="flex flex-col justify-around h-full w-1/2 items-start">
      {
        imagesBackground
          .slice(0, Math.ceil(imagesBackground.length / 2))
          .map((imageBackground, index) => (
            <div
              class={twMerge(
                "w-2/3 h-32 laptop:w-66 laptop:h-48 p-4 rounded-2xl border border-white/20 bg-diled-white/5 backdrop-blur-lg drop-shadow-2xl",
                imageBackground.classContainerImage
              )}
              data-aos="fade"
              data-aos-delay="100"
            >
              <Image
                src={imageBackground.url}
                class="w-full h-full object-cover rounded-lg opacity-80"
                alt={`Image-${index}`}
              />
            </div>
          ))
      }
    </div>

    {/* Columna derecha */}
    <div class="flex flex-col justify-around h-full w-1/2 items-end">
      {
        imagesBackground
          .slice(Math.ceil(imagesBackground.length / 2))
          .map((imageBackground, index) => (
            <div
              class={twMerge(
                "w-2/3 h-32 laptop:w-66 laptop:h-48 drop-shadow-2xl",
                imageBackground.classContainerImage
              )}
              data-aos="fade"
              data-aos-delay="100"
            >
              <Image
                src={imageBackground.url}
                class="w-full h-full object-cover rounded-lg opacity-80"
                alt={`Image-${index}`}
              />
            </div>
          ))
      }
    </div>
  </div>

  <ContainerCenter
    class="flex flex-col justify-center items-center gap-6 laptop:gap-10 px-6 laptop:px-0"
  >
    <div
      class="flex flex-col laptop:flex-row items-center justify-center gap-6 laptop:gap-10"
    >
      <section class="flex flex-col gap-6 laptop:gap-10 items-center">
        <h1
          class="text-4xl laptop:text-5xl prose font-semibold animate-fade-up text-center laptop:max-w-[70%] max-w-[85%] z-10 capitalize"
        >
          Soluciones <span class="text-diled-600">Inteligentes</span>, seguras y
          eficientes para tu hogar o negocio
        </h1>
        <p
          class="text-[.85rem] text-diled-gray-texts laptop:text-lg animate-fade-up prose animate-delay-300 text-center max-w-[85%] laptop:max-w-[60%]"
        >
          Consultoría especializada en TI, somos expertos para evaluar tus
          necesidades y poder ofrecerte soluciones a tu medida.
        </p>

        <div class="flex gap-4 w-full justify-center laptop:flex-row flex-col">
          <a
            class="bg-diled-600 cursor-pointer laptop:w-1/4 rounded-xl flex gap-1 justify-center items-center z-20 laptop:gap-5 text-white animate-fade-up animate-delay-500 py-4 px-2 active:scale-95 transition-all ease-in-out"
            href="https://wa.me/+5219992715345"
            target="_blank"
            ><span class="font-semibold text-lg">Contactanos</span>
            <Icon name="whatsapp" class="h-8 w-8" /></a
          >

          <button
            class="border-2 cursor-pointer border-diled-600 laptop:w-1/4 rounded-xl flex gap-1 justify-center items-center z-20 laptop:gap-5 text-diled-600 animate-fade-up animate-delay-500 py-4 px-2 active:scale-95 transition-all ease-in-out"
            id="scrollBtn"
            ><span class="font-semibold text-lg">Soluciones de éxito</span>
            <Icon name="solutions" class="h-8 w-8" />
          </button>
        </div>
      </section>
    </div>
  </ContainerCenter>
  <div
    class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-b from-[#f5f5f7] to-white"
  >
  </div>
</section>

<script>
  const btn = document.getElementById("scrollBtn");
  btn?.addEventListener("click", () => {
    const section = document.getElementById("Successful-Solutions");
    section?.scrollIntoView({ behavior: "smooth" });
  });
</script>
