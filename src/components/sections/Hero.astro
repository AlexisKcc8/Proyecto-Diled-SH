---
import ContainerCenter from "@components/ContainerCenter.astro";
import { Icon } from "astro-icon/components";
import Brands from "./Brands.astro";
import { Image } from "astro:assets";
import image from "@assets/5.svg";
// class="bg-[url(/src/assets/1.svg)] bg-no-repeat bg-center bg-cover text-white h-screen pt-6 laptop:pt-0 flex items-center justify-center"

// bg-gradient-to-b from-black/0 to-black/80 w-full h-screen justify-center items-center flex
---

<!-- <div
  class="bg-gradient-to-b from-diled-violet w-full to-diled-carrot h-screen opacity-70 absolute blur-3xl"
>
</div> -->
<div class="relative h-full w-full bg-slate-950">
  <div
    class="absolute bottom-0 left-[-20%] right-0 top-[-10%] h-[500px] w-[500px] overflow-hidden rounded-full bg-[radial-gradient(circle_farthest-side,rgba(255,0,182,.15),rgba(255,255,255,0))]"
  >
  </div>
  <section class="text-white w-full h-screen justify-center">
    <div
      class="w-full h-screen justify-center items-center flex backdrop-blur-2xl"
    >
      <div class="absolute top-12 right-12 -rotate-12">
        <Image
          src={image}
          class="w-44 h-28 object-cover rounded-lg z-0 opacity-20"
          alt=""
        />
        <div
          class="absolute w-full h-full bottom-0 left-0 bg-[radial-gradient(circle_farthest-side,rgba(255,0,182,.15),rgba(255,255,255,0))] opacity-100 z-10"
        >
        </div>
      </div>

      <ContainerCenter
        class="flex flex-col justify-center items-center gap-6 laptop:gap-10 px-6 laptop:px-0"
      >
        <div
          class="flex flex-col laptop:flex-row items-center justify-center gap-6 laptop:gap-10"
        >
          <section class="flex flex-col gap-6 laptop:gap-10 items-center">
            <!-- <div
              class="w-3/4 h-32 laptop:h-32 -rotate-12 laptop:w-96 absolute -z-0 rounded-full blur-3xl bg-gradient-to-r from-diled-carrot to-diled-gray opacity-20 laptop:opacity-35"
            >
            </div> -->
            <h1
              class="text-3xl laptop:text-6xl prose font-semibold animate-fade-up text-center laptop:max-w-[70%] max-w-[85%]"
            >
              Automatización, Seguridad e Iluminación <span
                class="text-diled-600">Inteligente</span
              > para tu Hogar
            </h1>
            <p
              class="text-base laptop:text-lg animate-fade-up prose animate-delay-300 text-center max-w-[85%] laptop:max-w-[60%]"
            >
              En Diled, transformamos tu hogar con tecnología avanzada en
              automatización residencial, iluminación, seguridad, audio, cine en
              casa, conectividad y control de acceso. Disfruta de un hogar más
              seguro, eficiente y cómodo con soluciones diseñadas para ti.
            </p>

            <button
              class="bg-diled-600 w-full laptop:w-1/4 rounded-xl hidden laptop:flex laptop:justify-center laptop:items-center laptop:gap-5 text-white animate-fade-up animate-delay-500 py-4 px-2 text-lg"
              ><span class="">Transforma tu hogar hoy</span>
              <Icon name="whatsapp" class="h-8 w-8" /></button
            >
          </section>
        </div>
      </ContainerCenter>
    </div>
    <!-- <Brands /> -->
  </section>
</div>

