---
import ContainerCenter from "@components/ContainerCenter.astro";
import CardReview from "@components/CardReview.astro";

import { Image } from "astro:assets";

const customerReviews = [
  {
    name: "Matt Prouse",
    review:
      "¡Increíble servicio! Transformaron mi hogar en un espacio inteligente con su sistema de automatización. Ahora controlo la iluminación, el audio y la seguridad desde mi celular. ¡100% recomendado!",
    charge: "President, DSPANZ",
    avatar: "/logo-diled.png",
    rotation: "-rotate-4",
  },
  {
    name: "Miranda Prouse",
    review:
      "La instalación del cine en casa fue perfecta. Imagen y sonido de primer nivel. ¡Siento que estoy en el cine sin salir de casa! Gracias, Diled Smart Home.",
    charge: "President, DSPANZ",
    avatar: "/logo-diled.png",
    rotation: "rotate-2",
  },
  {
    name: "Steven Gerrad",
    review:
      "¡Excelente servicio! Instalé un sistema de iluminación inteligente y ahora puedo crear ambientes perfectos con solo un toque en mi celular. Profesionalismo y calidad en cada detalle. ¡Totalmente recomendado!",
    charge: "President, DSPANZ",
    avatar: "/logo-diled.png",
    rotation: "-rotate-2",
  },
  {
    name: "Veronica Anstey",
    review:
      "La seguridad de mi casa mejoró muchísimo con las cámaras y sensores de Diled Smart Home. Me siento más tranquilo sabiendo que tengo todo monitoreado desde mi celular.",
    charge: "President, DSPANZ",
    avatar: "/logo-diled.png",
    rotation: "rotate-4",
  },
  {
    name: "Matias Liston",
    review:
      "Un equipo de expertos en domótica. Me asesoraron desde el principio y ahora tengo una casa totalmente automatizada. Profesionalismo y atención al cliente de primera.",
    charge: "President, DSPANZ",
    avatar: "/logo-diled.png",
    rotation: "-rotate-4",
  },
  {
    name: "Robert Prouse",
    review:
      "Siempre quise tener un sistema de audio envolvente en mi casa y ellos lo hicieron realidad. Calidad de sonido impresionante y sin cables por todos lados. ¡Gracias, Diled Smart Home!",
    charge: "President, DSPANZ",
    avatar: "/logo-diled.png",
    rotation: "-rotate-8",
  },
] as const;
---

<section
  class="w-full min-h-[100vh] overflow-hidden relative text-white flex justify-center pt-14 laptop:pt-26"
>
  <div class="absolute top-0 z-10 h-full w-full">
    <div
      class="absolute left-[50%] top-[50%] h-[500px] w-[500px] -translate-x-[50%] -translate-y-[50%] rounded-full bg-[rgba(173,109,244,0.5)] opacity-40 blur-[100px]"
    >
    </div>
  </div>
  <ContainerCenter
    class="flex flex-col items-center justify-center z-40 text-center py-8 px-6 laptop:px-0"
  >
    <h2
      class="font-semibold text-black text-3xl mb-12 laptop:text-5xl"
      data-aos="fade"
      data-aos-duration="900"
    >
      Descubre por qué <span class="text-diled-600">Diled</span> es tu mejor opción para tu proyecto de automatización.
    </h2>
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {customerReviews.map((review) => <CardReview dataReview={review} />)}
    </section>
  </ContainerCenter>
</section>
