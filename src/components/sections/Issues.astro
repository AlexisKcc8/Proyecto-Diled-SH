---
import ContainerCenter from "@components/ContainerCenter.astro";



const problematics = [
  {
    titulo: "🏠 ¡Tu casa no es inteligente, es desobediente!",
    text: "Luces encendidas todo el día, electrodomésticos consumiendo energía sin control… ¿Tu casa trabaja para ti o en tu contra?",
    urlImg: "/img/automatizacion.png",
  },
  {
    titulo: "💡 Iluminación que arruina el ambiente",
    text: "Espacios oscuros cuando necesitas luz, reflejos molestos en la pantalla o una iluminación que no se ajusta a tu día… ¿Te suena familiar?",
    urlImg: "/img/iluminacion.png",
  },
  {
    titulo: "🔐 ¿Tu seguridad depende de la suerte?",
    text: "Salir de casa con la incertidumbre de si dejaste puertas abiertas o sin saber qué pasa cuando no estás… ¿Qué tan seguro te sientes realmente?",
    urlImg: "/img/seguridad.png",
  },
  {
    titulo: "🎵 Sonido plano, aburrido y sin vida",
    text: "Altavoces con sonido pobre, música que se corta o una acústica que no aprovecha el espacio… ¿Tu audio está a la altura de la experiencia que mereces?",
    urlImg: "/img/audio.png",
  },
  {
    titulo: "🎬 Cine en casa… pero sin la magia",
    text: "Películas con mala calidad de imagen, sonido que no envuelve y un ambiente que no se siente como un cine… ¿Es realmente una experiencia inmersiva?",
    urlImg: "/img/cinema.png",
  },
  {
    titulo: "📹 Cámaras que no ven cuando más lo necesitas",
    text: "Ángulos ciegos, grabaciones de mala calidad o cámaras que fallan justo cuando más las necesitas… ¿Tu sistema de vigilancia es confiable?",
    urlImg: "/img/cctv.png",
  },
  {
    titulo: "📶 Internet que se cae en el peor momento",
    text: "Zonas sin señal, internet lento en el peor momento o desconexiones constantes… ¿Tu red te está saboteando?",
    urlImg: "/img/conectividad.png",
  },
];
---

<section class="relative flex justify-center items-center space-y-10 p-5 laptop:flex-row laptop:space-y-0 laptop:space-x-10">
  <ContainerCenter class="laptop:flex">
    <!-- Aside con la imagen fija -->
    <aside
      class="sticky top-0 left-0  z-30 p-4 w-full h-[50vh] flex justify-center items-center 
      laptop:h-screen  overflow-hidden"
    >
      {problematics.map((problematic, index) => (
        <img
          src={problematic.urlImg}
          alt="Problema actual"
          class={`absolute top-0 left-0 w-full h-full object-cover drop-shadow-[0_5px_10px_rgba(255,255,255,0.2)] 
          laptop:w-full laptop:h-[90vh] laptop:object-contain transition-all duration-700 ease-in-out
          ${index === 0 ? "opacity-100 translate-y-0" : "opacity-0 translate-y-10"}`}
          data-index={index}
        />
      ))}
    </aside>

    <!-- Sección de problemáticas -->
    <aside class="space-y-24 p-10 w-full">
      {problematics.map((problematic) => (
        <div class="relative">
          <div
            class="watched h-64 w-64 bg-gray-200 opacity-0 laptop:absolute top-0 left-0 z-20"
            data-img={problematic.urlImg}
          ></div>

          <div
            class="z-10 flex flex-col items-center justify-center text-center py-2 px-4   
              laptop:h-[90vh] laptop:items-start laptop:text-start"
          >
            <h2
              class="text-3xl font-bold text-diled-600 mb-4 laptop:text-5xl"
              data-aos="fade"
              data-aos-duration="500"
            >
              {problematic.titulo}
            </h2>
            <p
              class="text-diled-50 text-[1rem] prose laptop:text-xl max-w-full"
              data-aos="fade"
              data-aos-duration="500"
            >
              {problematic.text}
            </p>
          </div>
        </div>
      ))}
    </aside>
  </ContainerCenter>

  <!-- Ejecuta el script en el cliente -->
  <script src="@scripts/intersectionObserver.ts"></script>
</section>
