---
import ContainerCenter from "@components/ContainerCenter.astro";



const problematics = [
  {
    titulo: "🏠 ¿Tu casa hace tu vida más fácil… o más difícil?",
    text: "Luces encendidas sin motivo, aparatos gastando energía sin control. ¿No debería tu hogar adaptarse a ti?",
    urlImg: "/img/automatizacion.png",
  },
  {
    titulo: "💡 ¿Demasiada luz? ¿Muy poca? Nunca es la correcta.",
    text: "Oscuridad cuando trabajas, reflejos molestos en la tele. ¿Y si tu iluminación supiera exactamente lo que necesitas?",
    urlImg: "/img/iluminacion.png",
  },
  {
    titulo: "🔐 ¿Tu seguridad depende de la suerte?",
    text: "Salir y preguntarte si cerraste bien, cámaras que no sirven cuando pasa algo. ¿No prefieres tranquilidad real?",
    urlImg: "/img/seguridad.png",
  },
  {
    titulo: "🎵 ¿Tu música tiene vida… o es puro ruido?",
    text: "Bajos débiles, sonido sin profundidad, música que se corta. ¿Así quieres disfrutar de tu espacio?",
    urlImg: "/img/audio.png",
  },
  {
    titulo: "🎬 ¿Tu cine en casa es mágico… o solo una tele más?",
    text: "Sonido sin fuerza, imagen borrosa, sin atmósfera envolvente. ¿No mereces una experiencia real?",
    urlImg: "/img/cinema.png",
  },
  {
    titulo: "📹 ¿Tus cámaras ven todo… o solo lo fácil?",
    text: "Ángulos ciegos, mala calidad, sin pruebas cuando las necesitas. ¿Es eso lo que llamas protección?",
    urlImg: "/img/cctv.png",
  },
  {
    titulo: "📶 ¿Internet rápido? Ojalá...",
    text: "Reuniones que se congelan, WiFi que no llega a todos lados. ¿Te suena conocido?",
    urlImg: "/img/conectividad.png",
  },
];



---

<section class="relative flex justify-center items-center space-y-10 p-5 bg-slate-950 laptop:flex-row laptop:space-y-0 laptop:space-x-10">
  <ContainerCenter class="laptop:flex">
    <!-- Aside con la imagen fija -->
    <aside
      class="sticky top-0 left-0  z-30 p-4 w-full h-[50vh] bg-slate-950 flex justify-center items-center 
      laptop:h-screen  overflow-hidden"
    >
      <div class="relative w-full h-full  ">
        {problematics.map((problematic, index) => (
        <img
          src={problematic.urlImg}
          alt="Problema actual"
          class={`absolute top-0 left-0 w-full h-full object-cover drop-shadow-[0_5px_10px_rgba(255,255,255,0.4)] 
          laptop:w-full laptop:h-[90vh] laptop:object-contain transition-all duration-700 ease-in-out
          ${index === 0 ? "opacity-100 translate-y-0" : "opacity-0 translate-y-10"}`}
          data-index={index}
        />
      ))}
      
      </div>
    </aside>

    <!-- Sección de problemáticas -->
    <aside class="space-y-24 p-2 w-full">
      {problematics.map((problematic) => (
        <div class="relative">
          <div
            class="watched h-64 w-64 bg-gray-200 opacity-0 laptop:absolute top-0 left-0 z-20"
            data-img={problematic.urlImg}
          ></div>

          <div
            class="z-10 flex flex-col items-center justify-center text-center   
              laptop:h-[90vh] laptop:items-start laptop:text-start"
          >
            <h2
              class="text-4xl  font-bold prose text-diled-600 mb-4 laptop:text-5xl"
              data-aos="fade"
              data-aos-duration="500"
            >
              {problematic.titulo}
            </h2>
            <p
              class="text-diled-50 text-[1rem] prose laptop:text-xl max-w-full"
              data-aos="fade"
              data-aos-duration="500"
            >
              {problematic.text}
            </p>
          </div>
        </div>
      ))}
    </aside>
  </ContainerCenter>

  <!-- Ejecuta el script en el cliente -->
  <script src="@scripts/intersectionObserver.ts"></script>
</section>
