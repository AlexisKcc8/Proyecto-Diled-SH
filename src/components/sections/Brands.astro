---
import ContainerCenter from "@components/ContainerCenter.astro";
import { Icon } from "astro-icon/components";
const icons = ["bose", "lutron", "sonos", "denon", "klipsch"];
---

<div
  class="flex items-center w-full justify-center px-6 laptop:px-0 bg-slate-950"
>
  <ContainerCenter class="flex w-full h-fit rounded-xl">
    <div class="overflow-hidden flex">
      <div class="flex gap-5 pr-5 group flex-[0_0_100%]">
        {
          icons.map((icon) => (
            <div class="w-full justify-center items-center">
              <Icon
                name={icon}
                class="h-24 w-24 !opacity-100 text-diled-100/50"
              />
            </div>
          ))
        }
      </div>
      <div aria-hidden class="flex gap-5 pr-5 group flex-[0_0_100%]">
        {
          icons.map((icon) => (
            <div class="w-full justify-center items-center">
              <Icon
                name={icon}
                class="h-24 w-24 !opacity-100 text-diled-100/50"
              />
            </div>
          ))
        }
      </div>
    </div>
  </ContainerCenter>
</div>
