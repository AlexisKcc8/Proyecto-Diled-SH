---
import { twMerge } from "tailwind-merge";

const { dataReview } = Astro.props;
---

<div
  class:list={twMerge(
    "flex flex-col h-full text-white rounded-[1.5rem] bg-sky-100/80 backdrop-blur-xl p-6 border border-white/60 shadow-[0_8px_32px_rgba(180,210,255,0.4)] relative overflow-hidden",
    dataReview.rotation ? dataReview.rotation : ""
  )}
  data-aos="fade-up"
  data-aos-duration="900"
>     
  <div class="flex-grow mb-6 flex flex-col items-center justify-center text-start relative z-10">
    <p class="text-slate-800 text-[1rem] prose break-words w-full font-medium">
      {dataReview.review}
    </p>
  </div>

  <div class="w-full flex justify-start items-center my-2 relative z-10">
    <p class="text-amber-500">⭐⭐⭐⭐⭐</p>
  </div>

  {/* Avatar y usuario */}
  <div class="flex items-center mt-auto relative z-10">
    <div class="w-16 h-16 rounded-full overflow-hidden flex-shrink-0 border-2 border-sky-200 shadow-[0_4px_12px_rgba(180,210,255,0.5)]">
      <img
        src={dataReview.avatar || "/placeholder.svg"}
        alt={`Avatar de ${dataReview.name}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="ml-3 text-start">
      <h4 class="text-[1rem] font-medium text-slate-800">
        {dataReview.name}
      </h4>
      <p class="text-[.8rem] text-slate-600">
        {dataReview.charge}
      </p>
    </div>
  </div>
</div>


