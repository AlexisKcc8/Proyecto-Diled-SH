---
import { twMerge } from "tailwind-merge";

const { dataReview } = Astro.props;
---

<div
  class:list={twMerge(
    "flex flex-col h-full text-gray-300 rounded-[1rem] bg-[#020618] p-6 border border-[#111729] shadow-[6px_6px_12px_#01040f,-6px_-6px_12px_#060b24]",
    dataReview.rotation ? dataReview.rotation : ""
  )}
  data-aos="fade-up"
  data-aos-duration="900"
>
  <div class="flex-grow mb-6 flex flex-col items-center justify-center text-start">
    <p class="text-gray-200 text-[1rem] prose break-words w-full">
      {dataReview.review}
    </p>
  </div>

  <div class="w-full flex justify-start items-center my-2">
    <p class="text-diled-50">⭐⭐⭐⭐⭐</p>
  </div>

  {/* Avatar y usuario */}
  <div class="flex items-center mt-auto">
    <div class="w-16 h-16 rounded-full overflow-hidden flex-shrink-0 border border-[#ff7a00] shadow-[4px_4px_8px_#01040f,-4px_-4px_8px_#060b24]">
      <img
        src={dataReview.avatar || "/placeholder.svg"}
        alt={`Avatar de ${dataReview.name}`}
        class="w-full h-full object-cover"
      />
    </div>
    <div class="ml-3 text-start">
      <h4 class="text-[1rem] font-medium text-diled-600">
        {dataReview.name}
      </h4>
      <p class="text-[.8rem] text-diled-100">
        {dataReview.charge}
      </p>
    </div>
  </div>
</div>
