---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import "@styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <link rel="icon" type="image/svg+xml" href="/logo.png" />
    <meta
      name="google-site-verification"
      content="2IYFmQ6DR-zpbLsNpMWAZL0ukBhgdKrxM3mw9lIvAw0"
    />
    <title>Diled - Smart Home</title>
    <meta
      name="description"
      content="Automatización, seguridad e iluminación inteligente para tu hogar. Convierte tu casa en un Smart Home con tecnología avanzada. ¡Cotiza ahora!"
    />
  </head>
  <body>
    <div class="relative bg-slate-950 ">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
      <div
        class="absolute bottom-0 left-[-20%] right-0 top-[-10%] h-[500px] w-[500px] overflow-hidden rounded-full bg-[radial-gradient(circle_farthest-side,rgba(255,0,182,.15),rgba(255,255,255,0))]"
      >
      </div>
    </div>
  </body>
</html>

