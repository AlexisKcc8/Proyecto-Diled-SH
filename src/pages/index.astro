---
import Layout from "@layouts/Layout.astro";

import Hero from "@components/sections/Hero.astro";
import Issues from "@components/sections/Issues.astro";
import Reviews from "@components/sections/Reviews.astro";
import Brands from "@components/sections/Brands.astro";
import FloatingButton from "@components/sections/FloatingButton.astro";
import SuccessfulSolutions from "@components/sections/SuccessfulSolutions.astro";
import BannerReview from "@components/BannerReview.astro";
import Domotica from "@components/sections/Domotica.astro";
---

<Layout title="Diled - Smart Home ¡Tu solución!">
  <Hero />
  <Brands />
  <Issues  />
  <BannerReview />
  <Domotica />
  <SuccessfulSolutions />
  <Reviews />
  <FloatingButton />
</Layout>

<script>
  import { initAOS } from "@scripts/aos";
  document.addEventListener("DOMContentLoaded", () => {
    initAOS();
  });
</script>
